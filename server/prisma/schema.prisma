generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PresenceStatus {
  ONLINE
  IDLE
  DND
  OFFLINE
}

enum CommunityVisibility {
  PUBLIC
  PRIVATE
}

enum ChannelType {
  TEXT
  VOICE
  AI
  MUSIC
}

enum MemberRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum FriendStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  username     String         @unique
  displayName  String
  passwordHash String
  avatarUrl    String?
  bio          String?        @db.Text
  status       PresenceStatus @default(OFFLINE)
  customStatus String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  memberships      CommunityMember[]
  messages         Message[]
  reactions        Reaction[]
  sentRequests     Friendship[]      @relation("Sender")
  receivedRequests Friendship[]      @relation("Receiver")
  notifications    Notification[]
  bans             CommunityBan[]
  dmParticipants   DmParticipant[]
  voiceStates      VoiceState[]
  pinnedMessages   PinnedMessage[]
  auditLogs        AuditLog[]        @relation("Actor")
}

model Friendship {
  id         String       @id @default(cuid())
  senderId   String
  receiverId String
  status     FriendStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  sender     User         @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User         @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

model Community {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  description String?             @db.Text
  iconUrl     String?
  visibility  CommunityVisibility @default(PUBLIC)
  ownerId     String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  members   CommunityMember[]
  channels  Channel[]
  invites   Invite[]
  bans      CommunityBan[]
  auditLogs AuditLog[]
  roles     Role[]
}

model Role {
  id          String    @id @default(cuid())
  communityId String
  name        String
  color       String    @default("#8b9cff")
  position    Int       @default(0)
  permissions Int       @default(0)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  members     CommunityMember[]

  @@unique([communityId, name])
}

model CommunityMember {
  id          String     @id @default(cuid())
  communityId String
  userId      String
  role        MemberRole @default(MEMBER)
  roleId      String?
  nickname    String?
  joinedAt    DateTime   @default(now())
  mutedUntil  DateTime?
  community   Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole  Role?      @relation(fields: [roleId], references: [id])

  @@unique([communityId, userId])
}

model Channel {
  id          String      @id @default(cuid())
  communityId String?
  name        String
  type        ChannelType @default(TEXT)
  topic       String?
  position    Int         @default(0)
  isPrivate   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  community   Community?  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  messages    Message[]
  voiceStates VoiceState[]
  pins        PinnedMessage[]
  musicQueue  MusicQueueItem[]
}

model Message {
  id        String    @id @default(cuid())
  channelId String?
  dmId      String?
  authorId  String
  content   String    @db.Text
  editedAt  DateTime?
  deletedAt DateTime?
  parentId  String?
  createdAt DateTime  @default(now())
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  channel   Channel?  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  dm        DirectMessage? @relation(fields: [dmId], references: [id], onDelete: Cascade)
  parent    Message?  @relation("Thread", fields: [parentId], references: [id])
  replies   Message[] @relation("Thread")
  reactions Reaction[]
  attachments Attachment[]
  pins      PinnedMessage[]
}

model Attachment {
  id        String  @id @default(cuid())
  messageId String
  url       String
  filename  String
  mimeType  String
  size      Int
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model Reaction {
  id        String  @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model PinnedMessage {
  id        String   @id @default(cuid())
  channelId String
  messageId String
  pinnedBy  String
  pinnedAt  DateTime @default(now())
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [pinnedBy], references: [id])

  @@unique([channelId, messageId])
}

model DirectMessage {
  id           String          @id @default(cuid())
  createdAt    DateTime        @default(now())
  participants DmParticipant[]
  messages     Message[]
}

model DmParticipant {
  id     String        @id @default(cuid())
  dmId   String
  userId String
  dm     DirectMessage @relation(fields: [dmId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dmId, userId])
}

model Invite {
  id          String    @id @default(cuid())
  code        String    @unique
  communityId String
  createdBy   String
  maxUses     Int?
  uses        Int       @default(0)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
}

model CommunityBan {
  id          String    @id @default(cuid())
  communityId String
  userId      String
  reason      String?
  bannedBy    String
  createdAt   DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VoiceState {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  muted     Boolean  @default(false)
  deafened  Boolean  @default(false)
  video     Boolean  @default(false)
  sharing   Boolean  @default(false)
  joinedAt  DateTime @default(now())
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
}

model AuditLog {
  id          String    @id @default(cuid())
  communityId String
  actorId     String
  action      String
  targetType  String?
  targetId    String?
  meta        Json?
  createdAt   DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  actor       User      @relation("Actor", fields: [actorId], references: [id])
}

model MusicQueueItem {
  id         String   @id @default(cuid())
  channelId  String
  trackId    String
  title      String
  artist     String
  artworkUrl String?
  durationMs Int?
  source     String
  requestedBy String
  position   Int
  createdAt  DateTime @default(now())
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

model AiConversation {
  id        String   @id @default(cuid())
  channelId String?
  userId    String
  messages  Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
